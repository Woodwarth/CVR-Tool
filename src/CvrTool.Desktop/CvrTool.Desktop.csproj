<!-- Module: Provides the Avalonia interface for monitoring and controlling amplifiers.
     Build configuration for CvrTool.Desktop. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>Assets/AppIcon.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <ProjectReference Include="../CvrTool.Application/CvrTool.Application.csproj" />
    <ProjectReference Include="../CvrTool.Mcp/CvrTool.Mcp.csproj" />
    <ProjectReference Include="../CvrTool.Web/CvrTool.Web.csproj" />
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
  </ItemGroup>
</Project>
